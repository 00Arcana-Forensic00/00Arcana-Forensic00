name: Production Release Pipeline

on:
  push:
    branches: [ main ]
    tags:
      - 'v*'

jobs:
  test:
    name: Run Workspace Verification Tests
    runs-on: ubuntu-latest
    steps:
    - name: Clone Code Repository
      uses: actions/checkout@v4

    - name: Initialize Rust Toolchain
      uses: dtolnay/rust-toolchain@stable

    - name: Run Verification Checks
      run: cargo check --workspace

    - name: Run Test Suites
      run: cargo test --workspace

  release:
    name: Compile Cross-Platform Binaries
    needs: test
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
        include:
          - os: ubuntu-latest
            artifact_name: arcana-platform-linux
          - os: windows-latest
            artifact_name: arcana-platform-windows.exe
          - os: macos-latest
            artifact_name: arcana-platform-mac

    steps:
    - name: Clone Code Repository
      uses: actions/checkout@v4

    - name: Initialize Rust Toolchain
      uses: dtolnay/rust-toolchain@stable

    - name: Compile Release Binaries
      run: cargo build --release --workspace

    - name: Upload Distribution Artifacts
      uses: softprops/action-gh-release@v2
      with:
        files: |
          target/release/arcana-acquire*
          target/release/arcana-vault*
          target/release/arcana-custody*
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
